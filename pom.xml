<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.turnbase</groupId>
  <artifactId>turnbase-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>turnbase-platform</name>
  <description>TurnBase Platform Monolith — Spring Boot 3.5+, packaged by feature
    (ADR-0014).</description>

  <!--
    Unlike turnbase-common and turnbase-sdk, this artifact builds a Docker image and is never
    a Maven dependency of another repository, so its own version can stay a permanent
    development SNAPSHOT (conventions.md §5's no-SNAPSHOT rule is about published,
    consumed artifacts).
  -->
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Dependencies -->
    <!--
      CVE-2026-65182 (CRITICAL): a security-constraint bypass fixed in 10.1.58+, found by
      IMP-M0-11's Trivy dependency gate. Spring Boot 3.5.16 (already the latest 3.5.x) still
      manages 10.1.55; overriding the property is Spring Boot's own supported mechanism for
      this, and 10.1.58 was never published to Central — 10.1.59 is the first 10.1.x release
      that carries the fix.
    -->
    <tomcat.version>10.1.59</tomcat.version>
    <spring-modulith.version>1.4.13</spring-modulith.version>
    <!-- Matches turnbase-common's pin — grpc-netty-shaded is the transport turnbase-grpc
         deliberately leaves to its consumers to choose (conventions.md §5). -->
    <grpc.version>1.84.0</grpc.version>
    <jspecify.version>1.0.1</jspecify.version>
    <assertj.version>3.27.7</assertj.version>
    <!--
      Artifact store client (IMP-M0-07). file-uploads.md §1 runs the same pre-signed-URL code
      path against MinIO locally as against AWS S3 in production — the AWS SDK v2 S3 client
      talks to both by overriding the endpoint, so it is the client rather than a MinIO-specific
      SDK that would need swapping out for production.
    -->
    <aws-sdk.version>2.54.13</aws-sdk.version>

    <!--
      IMP-M0-10: JSON console encoding for Logback. Not managed by the Spring Boot BOM, unlike
      the Micrometer/OTel artifacts below.
    -->
    <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>

    <!--
      turnbase-common's published client stubs. No tagged release of turnbase-common exists
      yet, so this pins its current development version and resolves it from the local
      install, per conventions.md §5's bootstrap exception (IMP-GATE-07). Bump this to a real
      release, dropping -SNAPSHOT, once IMP-M0-11 publishes one and this repo gets its
      follow-up PR.
    -->
    <turnbase-common.version>0.1.0-SNAPSHOT</turnbase-common.version>

    <!-- Plugins -->
    <spotless.version>3.10.1</spotless.version>
    <google-java-format.version>1.36.1</google-java-format.version>
    <error-prone.version>2.50.0</error-prone.version>
    <nullaway.version>0.14.1</nullaway.version>
    <jacoco.version>0.8.15</jacoco.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>

    <!--
      Coverage floor. platform-operations.md FR-CICD-003 sets 70% across unit and
      integration together (conventions.md §3). Vacuous today — no hand-written logic yet,
      only the skeleton and the Modulith verification test — same documented shape as
      turnbase-common's coverage gate at IMP-M0-01. It stops being vacuous with the first
      class M1-01 adds.
    -->
    <jacoco.line.coverage>0.70</jacoco.line.coverage>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      IMP-M0-10: FR-MET-007's /actuator/prometheus, the OpenTelemetry Micrometer Tracing
      bridge for management.tracing.* (observability.md §4) and JSON console logging
      (observability.md §3). The OTLP exporter here is Micrometer's own bridge, separate from
      the -javaagent that does the actual HTTP/gRPC auto-instrumentation (Dockerfile).
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>${logstash-logback-encoder.version}</version>
    </dependency>

    <!--
      IMP-M0-06: Flyway baseline. jdbc rather than data-jpa — no ORM exists yet, and Flyway
      only needs a DataSource. platform-operations.md CON-002 fixes PostgreSQL as the store.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      IMP-M0-07: the artifact store client. MinIO locally, AWS S3 in production
      (file-uploads.md §1) — the v2 S3 client talks to both via an endpoint override.
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${aws-sdk.version}</version>
    </dependency>

    <!--
      ADR-0014: the module boundary is a build error, not a convention. spring-modulith-junit
      supplies ApplicationModules.of(...).verify() at test scope.
    -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      The internal Orchestration Service <-> Game Host contract (conventions.md §5). The
      monolith is the CLIENT for GameHostService (CreateSession/ProcessInput/Resync/
      TerminateSession) and the SERVER for GameHostRegistryService
      (Register/Heartbeat/ReportContexts/Deregister) — local-environment.md §2. Wiring both
      is IMP-M3-04/M3-05; this item only proves the stubs resolve and compile.
    -->
    <dependency>
      <groupId>io.turnbase</groupId>
      <artifactId>turnbase-grpc</artifactId>
      <version>${turnbase-common.version}</version>
    </dependency>
    <!-- turnbase-grpc declares no transport (conventions.md §5); the monolith picks one. -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
    </dependency>

    <!-- JSpecify @NullMarked is read by NullAway (ADR-0015). -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers-backed Postgres for *IT (conventions.md §3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>minio</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      IMP-M0-10 (IMP-GATE-18): lets the gRPC correlation-interceptor test exercise a real
      Client/ServerInterceptor pair with no network socket, same pattern turnbase-game-host
      uses for its registration-client test.
    -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Fail early and legibly on a wrong JDK or Maven, before anything else runs
        (conventions.md §6).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <phase>validate</phase>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Spotless at validate (conventions.md §2). The fix is ./mvnw spotless:apply.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>

      <!--
        Error Prone + NullAway (ADR-0015). AnnotatedPackages=io.turnbase.platform covers
        every feature package; Spring's own generated proxies and the gRPC stubs are not
        ours to annotate and are excluded by path/package below.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <!-- Required by Error Prone on JDK 21; it refuses to start without it. -->
            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
            <arg>-Xplugin:ErrorProne
              -XepExcludedPaths:.*/generated-sources/.*
              -Xep:NullAway:ERROR
              -XepOpt:NullAway:AnnotatedPackages=io.turnbase.platform
              -XepOpt:NullAway:ExcludedFieldAnnotations=org.springframework.beans.factory.annotation.Autowired</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${error-prone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>

      <!--
        JaCoCo. conventions.md §3: unit and integration exec files are merged before a
        single check — wiring one execution bound to test silently measures unit tests only
        and fails open.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-unit</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco/unit.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>merge-exec</id>
            <goals>
              <goal>merge</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.build.directory}/jacoco</directory>
                  <includes>
                    <include>*.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco/merged.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>report-merged</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <dataFile>${project.build.directory}/jacoco/merged.exec</dataFile>
              <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>check-merged</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <dataFile>${project.build.directory}/jacoco/merged.exec</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      conventions.md §3: *IT runs under failsafe, only with -Pintegration, against
      Testcontainers-backed Postgres/Redis/MinIO. Empty of tests today (no infrastructure
      dependency exists until IMP-M0-06/M0-09); present so the invocation is identical
      across the Java repositories and the exec file lands where the merge above expects it.
    -->
    <profile>
      <id>integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>prepare-integration</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
                <phase>pre-integration-test</phase>
                <configuration>
                  <destFile>${project.build.directory}/jacoco/integration.exec</destFile>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>${maven-failsafe-plugin.version}</version>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

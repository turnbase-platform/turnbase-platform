<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.turnbase</groupId>
  <artifactId>turnbase-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>turnbase-platform</name>
  <description>TurnBase Platform Monolith — Spring Boot 4.1+, packaged by feature
    (ADR-0014).</description>

  <!--
    Unlike turnbase-common and turnbase-sdk, this artifact builds a Docker image and is never
    a Maven dependency of another repository, so its own version can stay a permanent
    development SNAPSHOT (conventions.md §5's no-SNAPSHOT rule is about published,
    consumed artifacts).
  -->
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Dependencies -->
    <spring-modulith.version>2.1.1</spring-modulith.version>
    <!-- Matches turnbase-common's pin — grpc-netty-shaded is the transport turnbase-grpc
         deliberately leaves to its consumers to choose (conventions.md §5). -->
    <grpc.version>1.84.0</grpc.version>
    <!-- Boot 4.1's BOM manages 4.35.1; turnbase-grpc is generated with 4.36.0 and protobuf refuses an older runtime. -->
    <protobuf-java.version>4.36.0</protobuf-java.version>
    <jspecify.version>1.0.1</jspecify.version>
    <assertj.version>3.27.7</assertj.version>
    <!--
      Artifact store client (IMP-M0-07). file-uploads.md §1 runs the same pre-signed-URL code
      path against MinIO locally as against AWS S3 in production — the AWS SDK v2 S3 client
      talks to both by overriding the endpoint, so it is the client rather than a MinIO-specific
      SDK that would need swapping out for production.
    -->
    <!-- IMP-M11-02: independent of Spring; no change needed for Boot 4. -->
    <aws-sdk.version>2.54.13</aws-sdk.version>

    <!--
      IMP-M0-10: JSON console encoding for Logback. Not managed by the Spring Boot BOM, unlike
      the Micrometer/OTel artifacts below.
    -->
    <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>

    <!--
      turnbase-common's published client stubs. No tagged release of turnbase-common exists
      yet, so this pins its current development version and resolves it from the local
      install, per conventions.md §5's bootstrap exception (IMP-GATE-07). Bump this to a real
      release, dropping -SNAPSHOT, once IMP-M0-11 publishes one and this repo gets its
      follow-up PR.
    -->
    <turnbase-common.version>0.1.0-SNAPSHOT</turnbase-common.version>

    <!-- IMP-M1-03: HS256 JWT issuance/verification (secrets-and-configuration.md §3). -->
    <!-- IMP-M11-02: jjwt-jackson stays on Jackson 2 deliberately (ADR-0016 §2); never sees a Spring mapper. -->
    <jjwt.version>0.12.6</jjwt.version>

    <!--
      IMP-M1-04: username confusable-skeleton computation and single-script restriction
      (input-validation.md § Usernames — ICU4J com.ibm.icu.text.SpoofChecker is the document's
      own named mechanism, not a choice made here).
    -->
    <icu4j.version>78.3</icu4j.version>

    <!--
      IMP-M1-04: Argon2PasswordEncoder's runtime dependency (below). Not managed by the Spring
      Boot BOM — spring-security-crypto keeps it optional since not every consumer needs Argon2.
    -->
    <bouncycastle.version>1.85.2</bouncycastle.version>

    <!--
      IMP-M1-05: the guest purge job is the first scheduled job in this repo, so it is also the
      first to need FR-JOB-005's "exactly one instance per interval" guarantee. The baseline
      migration (IMP-M0-06) already carries ShedLock's fixed `shedlock` table
      (schema-migrations.md §5) for exactly this — net.javacrumbs.shedlock is the mechanism that
      table exists to serve, not a choice made here.
    -->
    <!-- IMP-M11-02: ShedLock 7.x targets Spring 7; compiles against Boot 4.1.1, exercised by the ITs (IMP-M11-04). -->
    <shedlock.version>7.7.0</shedlock.version>

    <!--
      IMP-M1-02: Tiers 1-5's Redis-backed buckets (rate-limiting.md). bucket4j_jdk17-* is the
      Java-21-targeted module line (conventions.md §1 pins Java 21); -core is the bucket/bandwidth
      API, -lettuce is the distributed proxy manager this repo's Lettuce client backs. No document
      names a library — "Redis (Bucket4j RedisBucket)" is rate-limiting.md's own phrase.
    -->
    <!-- IMP-M11-02: bucket4j-lettuce is built against Lettuce 6; kept for now, rate-limit ITs verify it on Lettuce 7 (IMP-M11-04, ADR-0016 R8). -->
    <bucket4j.version>8.19.0</bucket4j.version>

    <!-- Plugins -->
    <spotless.version>3.10.1</spotless.version>
    <google-java-format.version>1.36.1</google-java-format.version>
    <error-prone.version>2.50.0</error-prone.version>
    <nullaway.version>0.14.1</nullaway.version>
    <jacoco.version>0.8.15</jacoco.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>

    <!--
      Coverage floor. platform-operations.md FR-CICD-003 sets 70% across unit and
      integration together (conventions.md §3). Vacuous today — no hand-written logic yet,
      only the skeleton and the Modulith verification test — same documented shape as
      turnbase-common's coverage gate at IMP-M0-01. It stops being vacuous with the first
      class M1-01 adds.
    -->
    <jacoco.line.coverage>0.70</jacoco.line.coverage>

    <!--
      CVE-2026-75595 (CRITICAL): software.amazon.awssdk:s3's netty-nio-client transitively pulls
      Netty 4.1.135.Final, which the CI Trivy gate rejects. Not introduced by any work item — the
      AWS SDK client has been here since IMP-M0-07 — but it blocks every push until pinned forward,
      so it is fixed here rather than carried as a known-broken build. 4.1.137.Final is the fix
      version on the same major/minor line the AWS SDK's netty-nio-client was built against, so this
      stays a patch bump, not a Netty major-version jump.

      IMP-M11-03: now 4.2.17.Final, the line Boot 4's Lettuce 7 needs (4.1 lacks
      MultiThreadIoEventLoopGroup, so every Redis-backed bean failed at start). The AWS SDK's
      netty-nio-client against 4.2 is for IMP-M11-04's S3 integration tests to confirm (ADR-0016 R8).
    -->
    <netty.version>4.2.17.Final</netty.version>
    <!--
      IMP-M11-07 (ADR-0016 R14): Boot 4.1.1 manages Tomcat 11.0.24, which the Trivy image gate
      rejects (CVE-2026-65182, CVE-2026-65905, CVE-2026-68525, all CRITICAL, fixed in 11.0.25).
    -->
    <tomcat.version>11.0.25</tomcat.version>

    <!--
      IMP-M3-13: turnbase-bundle-validator (the upload pipeline's archive reader, manifest
      validation and Phase F analysis, shared with the SDK test harness) is built by
      turnbase-sdk. Same bootstrap exception as turnbase-common above: no tagged release exists,
      so this pins the current development version and resolves it from the local install. It
      brings json-schema-validator and ASM in transitively.
    -->
    <turnbase-sdk.version>0.1.0-SNAPSHOT</turnbase-sdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      IMP-M1-01: Bean Validation (input-validation.md's server-side rule, NFR-SEC-005) and the
      Pageable/Sort abstractions the pagination contract is built on (pagination-filtering-sorting.md).
      spring-data-commons carries PageableHandlerMethodArgumentResolver without pulling in a
      Spring Data store module — no JPA/repository exists yet.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-commons</artifactId>
    </dependency>

    <!--
      IMP-M0-10: FR-MET-007's /actuator/prometheus, the OpenTelemetry Micrometer Tracing
      bridge for management.tracing.* (observability.md §4) and JSON console logging
      (observability.md §3). The OTLP exporter here is Micrometer's own bridge, separate from
      the -javaagent that does the actual HTTP/gRPC auto-instrumentation (Dockerfile).
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>${logstash-logback-encoder.version}</version>
    </dependency>

    <!--
      IMP-M0-06: Flyway baseline. jdbc rather than data-jpa — no ORM exists yet, and Flyway
      only needs a DataSource. platform-operations.md CON-002 fixes PostgreSQL as the store.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <!-- Boot 4 split Flyway auto-configuration out of the core jar (ADR-0016 R7). -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      IMP-M1-03: JWT signing and verification (secrets-and-configuration.md §3). No document
      names a library — HS256 over a key set is the whole contract — but hand-rolling
      compact-JWT construction and parsing on the auth path is exactly the kind of code a
      maintained library gets right (constant-time signature comparison, header/claims
      validation) that a first attempt usually does not.
    -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!--
      IMP-M1-04: NFR-SEC-001's Argon2id password hashing. Spring Boot's dependency management
      resolves the version via the imported Spring Security BOM.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <!--
      Argon2PasswordEncoder delegates to Bouncy Castle's Argon2 implementation at runtime
      (org.bouncycastle.crypto.params.Argon2Parameters$Builder) — spring-security-crypto declares
      it as an optional dependency, so a consumer that actually uses Argon2id must add it itself.
    -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.ibm.icu</groupId>
      <artifactId>icu4j</artifactId>
      <version>${icu4j.version}</version>
    </dependency>

    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!--
      IMP-M0-07: the artifact store client. MinIO locally, AWS S3 in production
      (file-uploads.md §1) — the v2 S3 client talks to both via an endpoint override.
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${aws-sdk.version}</version>
    </dependency>

    <!-- IMP-M3-13: bundle validation (bundle-format.md §3 Phases C-F), extracted to turnbase-sdk. -->
    <dependency>
      <groupId>io.turnbase</groupId>
      <artifactId>turnbase-bundle-validator</artifactId>
      <version>${turnbase-sdk.version}</version>
    </dependency>

    <!-- IMP-M1-05: the guest purge job's cross-instance mutual exclusion (FR-JOB-005). -->
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-spring</artifactId>
      <version>${shedlock.version}</version>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-provider-jdbc-template</artifactId>
      <version>${shedlock.version}</version>
    </dependency>

    <!--
      IMP-M1-02: the first Redis usage site in this repo (conventions.md §7). local-environment.md
      §7.9 names the canonical property (spring.data.redis.url) that this starter's
      RedisConnectionDetails binds — used both for @ServiceConnection in tests and to build the
      raw Lettuce RedisClient Bucket4j's proxy manager needs (RateLimitRedisConfig), independent of
      the LettuceConnectionFactory bean this starter also autoconfigures.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- IMP-M10-14: idle-evicting pod-local Tier 6 maps (version managed by the Boot BOM). -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j_jdk17-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j_jdk17-lettuce</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>

    <!--
      IMP-M2-02: STOMP-over-WebSocket (websocket.md § Connection). bucket4j_jdk17-core above
      already carries the pod-local LocalBucket Tier 6 uses — no distributed proxy manager needed,
      by design (rate-limiting.md § Tier 6).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <!--
      ADR-0014: the module boundary is a build error, not a convention. spring-modulith-junit
      supplies ApplicationModules.of(...).verify() at test scope.
    -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      The internal Orchestration Service <-> Game Host contract (conventions.md §5). The
      monolith is the CLIENT for GameHostService (CreateSession/ProcessInput/Resync/
      TerminateSession) and the SERVER for GameHostRegistryService
      (Register/Heartbeat/ReportContexts/Deregister) — local-environment.md §2. Wiring both
      is IMP-M3-04/M3-05; this item only proves the stubs resolve and compile.
    -->
    <dependency>
      <groupId>io.turnbase</groupId>
      <artifactId>turnbase-grpc</artifactId>
      <version>${turnbase-common.version}</version>
    </dependency>
    <!-- turnbase-grpc declares no transport (conventions.md §5); the monolith picks one. -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
    </dependency>
    <!--
      local-environment.md §7.8: GameHostRegistryService shares the monolith's HTTP listener, so it
      is served through the servlet container (h2c on Tomcat) rather than a second Netty port.
    -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-servlet-jakarta</artifactId>
      <version>${grpc.version}</version>
    </dependency>

    <!-- JSpecify @NullMarked is read by NullAway (ADR-0015). -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers-backed Postgres for *IT (conventions.md §3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-minio</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      IMP-M0-10 (IMP-GATE-18): lets the gRPC correlation-interceptor test exercise a real
      Client/ServerInterceptor pair with no network socket, same pattern turnbase-game-host
      uses for its registration-client test.
    -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Fail early and legibly on a wrong JDK or Maven, before anything else runs
        (conventions.md §6).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <phase>validate</phase>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Spotless at validate (conventions.md §2). The fix is ./mvnw spotless:apply.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>

      <!--
        Error Prone + NullAway (ADR-0015). AnnotatedPackages=io.turnbase.platform covers
        every feature package; Spring's own generated proxies and the gRPC stubs are not
        ours to annotate and are excluded by path/package below.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <!-- Required by Error Prone on JDK 21; it refuses to start without it. -->
            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
            <arg>-Xplugin:ErrorProne
              -XepExcludedPaths:.*/generated-sources/.*
              -Xep:NullAway:ERROR
              -XepOpt:NullAway:AnnotatedPackages=io.turnbase.platform
              -XepOpt:NullAway:ExcludedFieldAnnotations=org.springframework.beans.factory.annotation.Autowired</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${error-prone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>

      <!--
        JaCoCo. conventions.md §3: unit and integration exec files are merged before a
        single check — wiring one execution bound to test silently measures unit tests only
        and fails open.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-unit</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco/unit.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>merge-exec</id>
            <goals>
              <goal>merge</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.build.directory}/jacoco</directory>
                  <includes>
                    <include>*.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco/merged.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>report-merged</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <dataFile>${project.build.directory}/jacoco/merged.exec</dataFile>
              <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>check-merged</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <dataFile>${project.build.directory}/jacoco/merged.exec</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      conventions.md §3: *IT runs under failsafe, only with -Pintegration, against
      Testcontainers-backed Postgres/Redis/MinIO. Empty of tests today (no infrastructure
      dependency exists until IMP-M0-06/M0-09); present so the invocation is identical
      across the Java repositories and the exec file lands where the merge above expects it.
    -->
    <profile>
      <id>integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>prepare-integration</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
                <phase>pre-integration-test</phase>
                <configuration>
                  <destFile>${project.build.directory}/jacoco/integration.exec</destFile>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>${maven-failsafe-plugin.version}</version>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <systemPropertyVariables>
                <!--
                  Every IT boots and closes an application per test method. With the default
                  http://tempo:4317 endpoint unresolvable, OpenTelemetrySdk.close() blocks about
                  8 s flushing spans to it on each close — roughly 13 of the ~22 minutes the
                  suite took in CI. Nothing in an IT asserts on exported spans.
                -->
                <management.otlp.tracing.export.enabled>false</management.otlp.tracing.export.enabled>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

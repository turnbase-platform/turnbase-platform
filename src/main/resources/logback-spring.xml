<?xml version="1.0" encoding="UTF-8"?>
<!--
  observability.md §3: JSON to stdout, never a file the application manages. Structure matches
  the worked example there — timestamp/level/service/logger/thread/message plus whichever of
  the five correlation IDs (requestId, userId, sessionId, roomId, gameId) and traceId/spanId
  are in the MDC. logstash-logback-encoder's mdc provider flattens present keys and omits
  absent ones by construction (FR-OBS-003's "omitted when absent", IMP-GATE-19) — nothing here
  writes a key it does not have a value for.
-->
<configuration>
  <springProperty scope="context" name="serviceName" source="spring.application.name"/>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <!-- Otherwise every Logback context property (springProperty included) leaks in as its
           own top-level field — "serviceName" alongside "service", not in the doc's schema. -->
      <includeContext>false</includeContext>
      <fieldNames>
        <timestamp>timestamp</timestamp>
        <logger>logger</logger>
        <thread>thread</thread>
        <message>message</message>
        <version>[ignore]</version>
        <levelValue>[ignore]</levelValue>
      </fieldNames>
      <customFields>{"service":"${serviceName}"}</customFields>
      <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
      <timeZone>UTC</timeZone>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>

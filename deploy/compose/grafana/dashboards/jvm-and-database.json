{
  "uid": "turnbase-jvm-and-database",
  "title": "JVM and Database",
  "tags": ["turnbase"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "JVM heap used (FR-MET-006)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom" },
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "GC pause duration (FR-MET-006)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom" },
          "expr": "sum by (application) (rate(jvm_gc_pause_seconds_sum[5m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Live thread count (FR-MET-006)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom" },
          "expr": "jvm_threads_live_threads",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "PostgreSQL pool utilization (FR-MET-004, FR-ALERT-004 at 80%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom" },
          "expr": "hikaricp_connections_active / hikaricp_connections_max",
          "legendFormat": "active / max"
        }
      ]
    }
  ]
}

# Copy to `.env` (git-ignored) and fill in every value before `docker compose up`.
# No default here works — secrets-and-configuration.md §2: a default that works is a default
# that reaches production.

# --- PostgreSQL (secrets-and-configuration.md §4) ---
# Owner: provisioning only, never held by a running service. Any strong local password.
TURNBASE_DB_OWNER_PASSWORD=
# Application role (`turnbase_app`) — the role the Platform Monolith actually connects as.
TURNBASE_DB_APP_PASSWORD=

# --- Redis (secrets-and-configuration.md §4) ---
TURNBASE_REDIS_PASSWORD=

# --- MinIO (secrets-and-configuration.md §4) ---
# One credential pair does both read and write locally; production splits this into two IAM
# roles, one read-only.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Google OAuth (secrets-and-configuration.md §5) ---
# Absent by default: FR-AUTH-007's Google login is unavailable without it, and the login page
# hides the button rather than offering one that fails.
TURNBASE_OAUTH_GOOGLE_CLIENT_ID=
TURNBASE_OAUTH_GOOGLE_CLIENT_SECRET=

# --- Admin API (secrets-and-configuration.md §1, admin-tooling.md CON-001) ---
TURNBASE_ADMIN_USERNAME=
TURNBASE_ADMIN_PASSWORD=

# --- Grafana (observability.md §5) ---
GF_SECURITY_ADMIN_PASSWORD=

# --- Alerting (observability.md §6) ---
# Absent by default: rules still evaluate with no receiver configured, only delivery is
# missing until this is set.
TURNBASE_ALERT_WEBHOOK_URL=

# `make env` copies this to `.env` (git-ignored) when none exists; `make check-env` fails naming
# any required variable that is missing or empty (secrets-and-configuration.md §2, IMP-GATE-94).
# The values below are dummies for the local compose stack only — its datastore ports bind to
# 127.0.0.1. Never reuse them anywhere else. Empty values are the optional variables.
# A changed database password needs `docker compose down -v` (local-environment.md §5): the
# postgres image reads it only when it first initialises the volume.

# --- PostgreSQL (secrets-and-configuration.md §4) ---
# Owner: provisioning only, never held by a running service. Any strong local password.
TURNBASE_DB_OWNER_PASSWORD=local-only-change-me
# Application role (`turnbase_app`) — the role the Platform Monolith actually connects as.
TURNBASE_DB_APP_PASSWORD=local-only-change-me

# --- Redis (secrets-and-configuration.md §4) ---
TURNBASE_REDIS_PASSWORD=local-only-change-me

# --- MinIO (secrets-and-configuration.md §4) ---
# The root account is held by the minio server and the one-shot minio-init job only (IMP-M10-21).
MINIO_ROOT_USER=turnbase-minio
MINIO_ROOT_PASSWORD=local-only-change-me
# The scoped service credential minio-init provisions, limited to the bundle bucket by
# minio/app-policy.json. This is what the Platform Monolith and the Game Host authenticate with;
# one pair does both read and write locally, production splits it into two IAM roles, one
# read-only. Must differ from the root pair; the secret is at least 8 characters.
TURNBASE_ARTIFACT_STORE_ACCESS_KEY=turnbase-app
TURNBASE_ARTIFACT_STORE_SECRET_KEY=local-only-change-me

# --- Google OAuth (secrets-and-configuration.md §5) ---
# Absent by default: FR-AUTH-007's Google login is unavailable without it, and the login page
# hides the button rather than offering one that fails.
TURNBASE_OAUTH_GOOGLE_CLIENT_ID=
TURNBASE_OAUTH_GOOGLE_CLIENT_SECRET=

# --- Admin API (secrets-and-configuration.md §1, admin-tooling.md CON-001) ---
TURNBASE_ADMIN_USERNAME=admin
TURNBASE_ADMIN_PASSWORD=local-only-change-me

# --- Grafana (observability.md §5) ---
GF_SECURITY_ADMIN_PASSWORD=local-only-change-me

# --- Alerting (observability.md §6) ---
# Absent by default: rules still evaluate with no receiver configured, only delivery is
# missing until this is set.
TURNBASE_ALERT_WEBHOOK_URL=
